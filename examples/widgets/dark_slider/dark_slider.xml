<widget>
    <api>
        <prop name="color" type="color"/>
    </api>
    
    <styles>
        <style name="main" 
               bg_color="0x333333" bg_opa="255"  
               radius="10"
               width="120"
               height="10"
               pad_all="0"/> 
        <style name="light_knob" 
               bg_color="0xeeeeee" bg_opa="255" 
               shadow_width="20"
               shadow_opa="120"
               shadow_offset_y="2" 
               radius="100" 
               pad_all="5"/>
        <style name="blue_indicator" 
               bg_color="0x0000ff" bg_opa="255" 
               radius="100"
               />
    </styles>

    <view extends="lv_slider" 
          align="center" min_value="20" max_value="40" send_draw_task_events="true">
          <style name="main" />
          <style name="light_knob" selector="knob"/>
          <style name="blue_indicator" selector="indicator"/>
    </view>
</widget>
